# scholarmesh — env opsional (semua connector free jalan TANPA env ini).
# Copy file ini jadi .env lalu isi yang dipakai; atau set langsung di config MCP client (bagian env).

# ── Free source (opsional, menaikkan rate limit) ──
OPENALEX_API_KEY=            # budget harian sendiri ($1/day) alih-alih berbagi per-IP
S2_API_KEY=                  # Semantic Scholar — menghilangkan 429 rate-limit
UNPAYWALL_EMAIL=             # email politeness Unpaywall (default pakai identitas server)
NCBI_API_KEY=                # PubMed E-utilities — 3 req/s anonim → 10 req/s (registrasi gratis)

# ── Free source dengan registrasi key ──
CORE_API_KEY=                # CORE — registrasi gratis di core.ac.uk (full-text OA terdalam)

# ── Regional / freemium ──
BAIDU_API_KEY=               # Baidu Scholar Qianfan — di luar 50 free call/hari

# ── Premium / key-required ──
ADS_TOKEN=                   # NASA ADS — gratis untuk peneliti (ui.adsabs.harvard.edu)
ALPHAXIV_API_KEY=            # alphaXiv — ATAU langsung pakai MCP resmi: https://api.alphaxiv.org/mcp/v1
SCOPUS_API_KEY=              # Scopus — perlu entitlement institusi juga
LENS_TOKEN=                  # The Lens — approval manual
DIMENSIONS_TOKEN=            # Dimensions
WOS_API_KEY=                 # Web of Science Lite API (Clarivate)
AMINER_API_KEY=              # AMiner open platform
CSTR_CLIENT_ID=              # CSTR OpenAPI v3
CSTR_SECRET=
